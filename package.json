{
  "name": "conclave",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:mediapipe-privacy": "node scripts/check-mediapipe-privacy.mjs",
    "check:video-effect-assets": "node scripts/check-video-effect-assets.mjs",
    "check:swift-events": "node packages/meeting-core/scripts/gen-swift-events.mjs --check",
    "debug:video-effects": "node scripts/debug-video-effects-headless.mjs",
    "debug:video-effects:face": "node scripts/debug-video-effects-face.mjs",
    "observe:meet-effects": "node scripts/observe-meet-effects-headless.mjs",
    "probe:low-bandwidth": "node scripts/probe-low-bandwidth-meet.mjs",
    "probe:low-bandwidth:downshift": "CONCLAVE_LOW_BANDWIDTH_SCENARIO=transition CONCLAVE_LOW_BANDWIDTH_PROFILE=good CONCLAVE_LOW_BANDWIDTH_TRANSITION_TARGET=emergency CONCLAVE_LOW_BANDWIDTH_SETTLE_MS=12000 CONCLAVE_LOW_BANDWIDTH_TRANSITION_SETTLE_MS=26000 node scripts/probe-low-bandwidth-meet.mjs",
    "probe:low-bandwidth:recovery": "CONCLAVE_LOW_BANDWIDTH_SCENARIO=transition CONCLAVE_LOW_BANDWIDTH_PROFILE=emergency CONCLAVE_LOW_BANDWIDTH_TRANSITION_TARGET=good CONCLAVE_LOW_BANDWIDTH_TRANSITION_SETTLE_MS=55000 node scripts/probe-low-bandwidth-meet.mjs",
    "probe:low-bandwidth:receive-downshift": "CONCLAVE_LOW_BANDWIDTH_SCENARIO=receive-transition CONCLAVE_LOW_BANDWIDTH_PROFILE=good CONCLAVE_LOW_BANDWIDTH_TRANSITION_TARGET=emergency CONCLAVE_LOW_BANDWIDTH_SETTLE_MS=12000 CONCLAVE_LOW_BANDWIDTH_TRANSITION_SETTLE_MS=26000 node scripts/probe-low-bandwidth-meet.mjs",
    "probe:low-bandwidth:receive-recovery": "CONCLAVE_LOW_BANDWIDTH_SCENARIO=receive-transition CONCLAVE_LOW_BANDWIDTH_PROFILE=emergency CONCLAVE_LOW_BANDWIDTH_TRANSITION_TARGET=good CONCLAVE_LOW_BANDWIDTH_TRANSITION_SETTLE_MS=55000 node scripts/probe-low-bandwidth-meet.mjs",
    "quality:video": "node scripts/quality/run-headless-video-quality.mjs --matrix",
    "quality:video:quick": "node scripts/quality/run-headless-video-quality.mjs --profile pristine --duration-ms 12000",
    "quality:video:compat": "node scripts/quality/run-headless-video-quality.mjs --profile pristine --codec-scenario native-compat --duration-ms 12000",
    "quality:video:asymmetric": "node scripts/quality/run-headless-video-quality.mjs --profile poor --publisher-network-profile pristine --duration-ms 12000",
    "quality:video:repeat": "node scripts/quality/run-headless-video-quality.mjs --profile pristine --duration-ms 12000 --repetitions 3",
    "quality:video:compat:repeat": "node scripts/quality/run-headless-video-quality.mjs --profile pristine --codec-scenario native-compat --duration-ms 12000 --repetitions 3",
    "quality:video:transition": "node scripts/quality/run-headless-video-quality.mjs --dynamic-network-transition",
    "test:quality-harness": "node --test scripts/quality/*.test.mjs",
    "test:deploy-preflight": "node --test scripts/deploy-sfu-preflight.test.mjs scripts/deploy-sfu.test.mjs scripts/deploy-sfu-state.test.mjs scripts/deploy-browser-service.test.mjs",
    "test:deploy-crash": "node --test scripts/deploy-sfu-crash.test.mjs",
    "test:deploy-fuzz": "node --test scripts/deploy-sfu-fuzz.test.mjs",
    "test:deploy-fuzz-b": "DEPLOY_FUZZ_SEED=71 DEPLOY_FUZZ_RUNS=65 node --test --test-name-pattern=fault scripts/deploy-sfu-fuzz.test.mjs",
    "test:deploy-fuzz-c": "DEPLOY_FUZZ_SEED=136 DEPLOY_FUZZ_RUNS=65 node --test --test-name-pattern=fault scripts/deploy-sfu-fuzz.test.mjs",
    "test:deploy-compose": "CONCLAVE_REQUIRE_DOCKER=1 node --test scripts/deploy-sfu-preflight.test.mjs",
    "test:cloudflare-manifests": "node --test scripts/cloudflare-manifests.test.mjs",
    "test:docker-context": "node --test scripts/check-docker-context.test.mjs scripts/check-docker-images.test.mjs",
    "check:docker-context": "node scripts/check-docker-context.mjs",
    "check:sfu-source-manifest": "node packages/sfu/scripts/gen-source-manifest.mjs --check",
    "check:docker-images": "node scripts/check-docker-images.mjs",
    "build:conclave-skip:android": "bash scripts/build-conclave-skip-android-debug.sh",
    "build": "pnpm --filter conclave-web --filter @conclave/shared-browser run build",
    "test": "pnpm run test:quality-harness && pnpm run test:deploy-preflight && pnpm run test:deploy-crash && pnpm run test:deploy-fuzz && pnpm run test:cloudflare-manifests && pnpm run test:docker-context && pnpm --filter conclave-web --filter @conclave/meeting-core --filter @conclave/ai --filter @conclave/sfu --filter @conclave/shared-browser run test && pnpm run test:native-tokens && pnpm run test:native-icons && pnpm -C packages/apps-sdk run test:native-embed && pnpm -C packages/apps-sdk run test:native-embed-apps && pnpm -C packages/apps-sdk run test:scripts && pnpm run test:native-test-stores",
    "typecheck": "pnpm --filter conclave-web --filter @conclave/apps-sdk --filter @conclave/meeting-core --filter @conclave/ai --filter @conclave/sfu --filter @conclave/shared-browser run typecheck",
    "konsistent": "konsistent",
    "lint:packages": "eslint packages",
    "lint:workspace": "eslint . --pass-on-unpruned-suppressions",
    "lint:web": "pnpm -C apps/web run lint --pass-on-unpruned-suppressions",
    "lint:comments": "node scripts/quality/comments/ratchet.mjs",
    "test:comments": "node --test scripts/quality/comments/*.test.mjs",
    "lint": "pnpm run lint:workspace && pnpm run lint:web && pnpm run konsistent && pnpm run lint:comments",
    "comments:list": "node scripts/quality/comments/extract.mjs",
    "comments:tools": "node scripts/quality/comments/tools.mjs",
    "comments:sweep": "node scripts/quality/comments/sweep.mjs && node scripts/quality/comments/ratchet.mjs --full && eslint . --prune-suppressions && pnpm -C apps/web run lint --prune-suppressions && node scripts/quality/comments/ratchet.mjs --update",
    "comments:prune": "pnpm run comments:sweep",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:comments && pnpm -C packages/apps-sdk run check:apps && pnpm run check:video-effect-assets && pnpm run check:swift-events && pnpm run check:native-tokens && pnpm run check:native-icons && pnpm run check:native-embed && pnpm run check:native-emoji && pnpm run check:native-game-fixtures && pnpm run check:native-test-stores && pnpm run check:json-store-fixtures && pnpm run check:docker-context && pnpm run check:sfu-source-manifest",
    "check:native-embed": "pnpm -C packages/apps-sdk run check:native-embed",
    "generate:native-emoji": "node scripts/gen-native-emoji-shortcodes.mjs",
    "check:native-test-stores": "node scripts/check-native-test-stores.mjs",
    "check:json-store-fixtures": "pnpm -C packages/sfu exec tsx scripts/write-staging-rollback-fixtures.ts --check",
    "generate:json-store-fixtures": "pnpm -C packages/sfu exec tsx scripts/write-staging-rollback-fixtures.ts",
    "test:native-test-stores": "node --test scripts/check-native-test-stores.test.mjs",
    "check:native-emoji": "node scripts/gen-native-emoji-shortcodes.mjs --check",
    "check:native-game-fixtures": "pnpm -C packages/sfu exec tsx scripts/capture-long-shot-fixtures.ts --check && pnpm -C packages/sfu exec tsx scripts/capture-wordle-native-fixtures.ts --check",
    "generate:native-icons": "python3 -B packages/ui-tokens/scripts/gen-native-icons.py",
    "check:native-icons": "python3 -B packages/ui-tokens/scripts/gen-native-icons.py --check",
    "test:native-icons": "python3 -B packages/ui-tokens/scripts/gen-native-icons.test.py",
    "check:native-tokens": "node packages/ui-tokens/scripts/gen-native-tokens.mjs --check",
    "test:native-tokens": "node --test packages/ui-tokens/scripts/gen-native-tokens.test.mjs"
  },
  "devDependencies": {
    "@csstools/css-tokenizer": "4.0.3",
    "eslint": "^10.15.0",
    "konsistent": "1.0.0-beta.13",
    "sh-syntax": "0.8.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
