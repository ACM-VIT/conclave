{
  "name": "conclave",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "workspaces": [
    "apps/*",
    "!apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "check:mediapipe-privacy": "node scripts/check-mediapipe-privacy.mjs",
    "check:video-effect-assets": "node scripts/check-video-effect-assets.mjs",
    "check:swift-events": "node packages/meeting-core/scripts/gen-swift-events.mjs --check",
    "debug:video-effects": "node scripts/debug-video-effects-headless.mjs",
    "debug:video-effects:face": "node scripts/debug-video-effects-face.mjs",
    "observe:meet-effects": "node scripts/observe-meet-effects-headless.mjs",
    "probe:low-bandwidth": "node scripts/probe-low-bandwidth-meet.mjs",
    "probe:low-bandwidth:downshift": "CONCLAVE_LOW_BANDWIDTH_SCENARIO=transition CONCLAVE_LOW_BANDWIDTH_PROFILE=good CONCLAVE_LOW_BANDWIDTH_TRANSITION_TARGET=emergency CONCLAVE_LOW_BANDWIDTH_SETTLE_MS=12000 CONCLAVE_LOW_BANDWIDTH_TRANSITION_SETTLE_MS=26000 node scripts/probe-low-bandwidth-meet.mjs",
    "probe:low-bandwidth:recovery": "CONCLAVE_LOW_BANDWIDTH_SCENARIO=transition CONCLAVE_LOW_BANDWIDTH_PROFILE=emergency CONCLAVE_LOW_BANDWIDTH_TRANSITION_TARGET=good CONCLAVE_LOW_BANDWIDTH_TRANSITION_SETTLE_MS=55000 node scripts/probe-low-bandwidth-meet.mjs",
    "probe:low-bandwidth:receive-downshift": "CONCLAVE_LOW_BANDWIDTH_SCENARIO=receive-transition CONCLAVE_LOW_BANDWIDTH_PROFILE=good CONCLAVE_LOW_BANDWIDTH_TRANSITION_TARGET=emergency CONCLAVE_LOW_BANDWIDTH_SETTLE_MS=12000 CONCLAVE_LOW_BANDWIDTH_TRANSITION_SETTLE_MS=26000 node scripts/probe-low-bandwidth-meet.mjs",
    "probe:low-bandwidth:receive-recovery": "CONCLAVE_LOW_BANDWIDTH_SCENARIO=receive-transition CONCLAVE_LOW_BANDWIDTH_PROFILE=emergency CONCLAVE_LOW_BANDWIDTH_TRANSITION_TARGET=good CONCLAVE_LOW_BANDWIDTH_TRANSITION_SETTLE_MS=55000 node scripts/probe-low-bandwidth-meet.mjs",
    "quality:video": "node scripts/quality/run-headless-video-quality.mjs --matrix",
    "quality:video:quick": "node scripts/quality/run-headless-video-quality.mjs --profile pristine --duration-ms 12000",
    "quality:video:compat": "node scripts/quality/run-headless-video-quality.mjs --profile pristine --codec-scenario native-compat --duration-ms 12000",
    "quality:video:asymmetric": "node scripts/quality/run-headless-video-quality.mjs --profile poor --publisher-network-profile pristine --duration-ms 12000",
    "quality:video:repeat": "node scripts/quality/run-headless-video-quality.mjs --profile pristine --duration-ms 12000 --repetitions 3",
    "quality:video:compat:repeat": "node scripts/quality/run-headless-video-quality.mjs --profile pristine --codec-scenario native-compat --duration-ms 12000 --repetitions 3",
    "quality:video:transition": "node scripts/quality/run-headless-video-quality.mjs --dynamic-network-transition",
    "test:quality-harness": "node --test scripts/quality/*.test.mjs",
    "test:deploy-preflight": "node --test scripts/deploy-sfu-preflight.test.mjs",
    "test:cloudflare-manifests": "node --test scripts/cloudflare-manifests.test.mjs",
    "build:conclave-skip:android": "bash scripts/build-conclave-skip-android-debug.sh",
    "build": "pnpm --filter conclave-web --filter @conclave/shared-browser run build",
    "test": "pnpm run test:quality-harness && pnpm run test:deploy-preflight && pnpm run test:cloudflare-manifests && pnpm --filter conclave-web --filter @conclave/meeting-core --filter @conclave/ai --filter @conclave/sfu --filter @conclave/shared-browser run test && pnpm run test:native-tokens && pnpm run test:native-icons && pnpm -C packages/apps-sdk run test:native-embed && pnpm -C packages/apps-sdk run test:native-embed-apps",
    "typecheck": "pnpm --filter conclave-web --filter @conclave/apps-sdk --filter @conclave/meeting-core --filter @conclave/ai --filter @conclave/sfu --filter @conclave/shared-browser run typecheck",
    "konsistent": "konsistent",
    "lint:packages": "eslint packages",
    "lint:web": "pnpm -C apps/web run lint",
    "lint": "pnpm run lint:packages && pnpm run lint:web && pnpm run konsistent",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm -C packages/apps-sdk run check:apps && pnpm run check:video-effect-assets && pnpm run check:swift-events && pnpm run check:native-tokens && pnpm run check:native-icons && pnpm run check:native-embed",
    "check:native-embed": "pnpm -C packages/apps-sdk run check:native-embed",
    "generate:native-icons": "python3 -B packages/ui-tokens/scripts/gen-native-icons.py",
    "check:native-icons": "python3 -B packages/ui-tokens/scripts/gen-native-icons.py --check",
    "test:native-icons": "python3 -B packages/ui-tokens/scripts/gen-native-icons.test.py",
    "check:native-tokens": "node packages/ui-tokens/scripts/gen-native-tokens.mjs --check",
    "test:native-tokens": "node --test packages/ui-tokens/scripts/gen-native-tokens.test.mjs"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "konsistent": "1.0.0-beta.12",
    "typescript-eslint": "^8.71.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
