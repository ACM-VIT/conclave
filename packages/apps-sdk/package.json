{
  "name": "@conclave/apps-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "new:app": "node ./scripts/create-app-integration.mjs",
    "check:apps": "node ./scripts/check-app-integrations.mjs",
    "check:apps:fix": "node ./scripts/check-app-integrations.mjs --fix",
    "build:native-embed": "node ./src/native-embed/build/build-native-embed.mjs",
    "check:native-embed": "node ./src/native-embed/build/build-native-embed.mjs --check",
    "test:native-embed": "node --test ./scripts/native-embed-contract-test.mjs",
    "test:native-embed-apps": "node --test ./src/native-embed/tests/wheel-watch-contract-test.mjs",
    "test:scripts": "node --test ./scripts/check-app-integrations.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./authority": "./src/sdk/authority/index.ts",
    "./authority/server": "./src/sdk/authority/server.ts",
    "./dev-playground/core": "./src/apps/dev-playground/core/index.ts",
    "./dev-playground/web": "./src/apps/dev-playground/web/index.ts",
    "./native-embed": "./src/native-embed/index.ts",
    "./polls/core": "./src/apps/polls/core/index.ts",
    "./polls/server": "./src/apps/polls/server/index.ts",
    "./polls/web": "./src/apps/polls/web/index.ts",
    "./qa/core": "./src/apps/qa/core/index.ts",
    "./qa/server": "./src/apps/qa/server/index.ts",
    "./qa/web": "./src/apps/qa/web/index.ts",
    "./watch/core": "./src/apps/watch/core/index.ts",
    "./watch/web": "./src/apps/watch/web/index.ts",
    "./wheel/core": "./src/apps/wheel/core/index.ts",
    "./wheel/web": "./src/apps/wheel/web/index.ts",
    "./whiteboard/core": "./src/apps/whiteboard/core/index.ts",
    "./whiteboard/web": "./src/apps/whiteboard/web/index.ts"
  },
  "imports": {
    "#authority/schema": "./src/sdk/authority/schema.ts",
    "#authority/contract": "./src/sdk/authority/contract.ts",
    "#authority/wire": "./src/sdk/authority/wire.ts",
    "#authority/definition": "./src/sdk/authority/definition.ts",
    "#authority/client": "./src/sdk/authority/client.ts",
    "#sdk/text": "./src/sdk/text.ts",
    "#sdk/graphemes": "./src/sdk/graphemes.ts",
    "#native-embed/protocol": "./src/native-embed/protocol.ts"
  },
  "dependencies": {
    "@conclave/ai": "workspace:*",
    "react-player": "^3.4.0",
    "y-protocols": "^1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "peerDependencies": {
    "react": "*",
    "socket.io-client": "*"
  }
}
