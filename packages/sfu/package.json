{
  "name": "@conclave/sfu",
  "version": "0.1.0",
  "description": "Mediasoup SFU for Conclave",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "predev": "node scripts/ensure-mediasoup-worker.mjs",
    "dev": "npx tsx server.ts",
    "prestart": "node scripts/ensure-mediasoup-worker.mjs",
    "start": "npx tsx server.ts",
    "email:dev": "react-email dev --dir server/email --port 3002",
    "new:game": "node ./scripts/new-game.mjs",
    "test:game-ai": "npx tsx scripts/test-game-ai.ts",
    "test": "vitest run test",
    "typecheck": "tsc --noEmit",
    "build:canary": "node scripts/build-canary.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@conclave/ai": "workspace:*",
    "@conclave/apps-sdk": "workspace:*",
    "@conclave/meeting-core": "workspace:*",
    "@conclave/shared-browser": "workspace:*",
    "@conclave/ui-tokens": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "chess.js": "^1.4.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mediasoup": "^3.32.2",
    "openai": "^7.62.0",
    "opusscript": "0.1.1",
    "posthog-node": "^6.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.16",
    "redis": "^6.3.1",
    "socket.io": "^4.8.4",
    "y-protocols": "^1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "0.28.2",
    "mediasoup-client": "3.26.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.1",
    "werift": "0.26.0"
  }
}
