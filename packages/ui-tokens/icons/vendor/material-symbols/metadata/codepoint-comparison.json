  "disposition": "Numeric differences are preserved, not treated as aliases or normalized away. The pinned updater selects SVGs by name/family/style/size, without consulting codepoints. Codepoints are separately enumerated from the font. These values are not used for SVG conversion; no font lookup is authorized.",
  "source_evidence": [
    {
      "file": "upstream/update_symbols.py.txt",
      "sha256": "7d62ec54ca9ce638104f8ed03d5c0d05ba8366459e722072cc1658e07e565e42",
      "bytes": 8287,
      "lines": [
        52,
        60
      ],
      "purpose": "SVG identity fields and name-based path template",
      "text": "class Icon(NamedTuple):\n    name: str\n    version: int\n    stylistic_sets: Set[str]\n\n_ICON_ASSETS = (\n    Asset(\n        \"https://{host}/s/i/short-term/release/{stylistic_set_snake}/{icon.name}/{style}/{size_px}px.svg\",\n        \"symbols/web/{icon.name}/{stylistic_set_snake}/{icon.name}{style_suffix}_{size_px}px.svg\","
    },
    {
      "file": "upstream/update_symbols.py.txt",
      "sha256": "7d62ec54ca9ce638104f8ed03d5c0d05ba8366459e722072cc1658e07e565e42",
      "bytes": 8287,
      "lines": [
        106,
        114
      ],
      "purpose": "Family eligibility uses name and unsupported_families, not codepoint",
      "text": "def _icons(metadata):\n    all_sets = _symbol_families(metadata)\n    for raw_icon in metadata[\"icons\"]:\n        unsupported = set(raw_icon[\"unsupported_families\"])\n        yield Icon(\n            raw_icon[\"name\"],\n            raw_icon[\"version\"],\n            all_sets - unsupported,\n        )"
    },
    {
      "file": "upstream/update_symbols.py.txt",
      "sha256": "7d62ec54ca9ce638104f8ed03d5c0d05ba8366459e722072cc1658e07e565e42",
      "bytes": 8287,
      "lines": [
        154,
        167
      ],
      "purpose": "Font codepoints are separately enumerated from a fetched/decompressed font; not metadata SVG selectors",
      "text": "\ndef _fetch_fonts(css_files: Sequence[Path]):\n    for css_file in css_files:\n        css = css_file.read_text()\n        url = re.search(r\"src:\\s+url\\(([^)]+)\\)\", css).group(1)\n        assert url.endswith(\".woff2\")\n        woff2_file = css_file.parent / (css_file.stem + \".woff2\")\n        dest_file = css_file.parent / (css_file.stem + \".ttf\")\n        _do_fetch(url, woff2_file)\n        decompress(woff2_file, dest_file)\n        css_file.unlink()\n        with open(dest_file.with_suffix(\".codepoints\"), \"w\") as f:\n            for name, codepoint in sorted(icons.enumerate(dest_file)):\n                f.write(f\"{name} {codepoint:04x}\\n\")"
    }
  ],
