{
    "name": "@conclave/shared-browser",
    "version": "0.1.0",
    "description": "Chromium and Cloudflare Kitesurf shared browser service for Conclave",
    "type": "module",
    "exports": {
        "./kitesurf": "./src/kitesurf.ts"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "start": "node dist/server.js",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test test/*.test.ts"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "dockerode": "^5.0.1",
        "express": "^5.2.1",
        "puppeteer-core": "^25.10.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/dockerode": "^4.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^22.20.2",
        "tsx": "^4.23.13",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "@typescript/native": "npm:typescript@^7.0.2"
    }
}
