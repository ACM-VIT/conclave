{
  "name": "conclave-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build && node scripts/prune-open-next-og.mjs",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "pnpm run cf:build && pnpm run cf:deploy:direct",
    "cf:deploy:direct": "wrangler deploy --config wrangler.jsonc --domain conclave.acmvit.in --autoconfig false",
    "scheduling-email:dev": "wrangler dev --config wrangler.scheduling-email.jsonc --port 8789",
    "scheduling-email:deploy": "wrangler deploy --config wrangler.scheduling-email.jsonc",
    "scheduling-email:typecheck": "tsc --noEmit -p scheduling-email-worker/tsconfig.json",
    "transcript:dev": "wrangler dev --config wrangler.transcript.jsonc --port 8788",
    "transcript:deploy": "wrangler deploy --config wrangler.transcript.jsonc",
    "transcript:typecheck": "tsc --noEmit -p transcript-worker/tsconfig.json",
    "analyze": "next experimental-analyze --output",
    "analyze:serve": "next experimental-analyze --serve",
    "test:unit": "vitest run --dir test",
    "test": "pnpm run test:unit",
    "typecheck": "next typegen && tsc --noEmit && pnpm run scheduling-email:typecheck && pnpm run transcript:typecheck",
    "sync:noise-suppressor": "node scripts/sync-noise-suppressor-assets.mjs",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@conclave/apps-sdk": "workspace:*",
    "@conclave/meeting-core": "workspace:*",
    "@conclave/ui-tokens": "workspace:*",
    "@mediapipe/face_mesh": "0.4.1633559619",
    "@mediapipe/selfie_segmentation": "0.1.1675465747",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "@tanstack/hotkeys": "^0.8.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "better-auth": "^1.7.4",
    "clsx": "^2.1.1",
    "facehash": "^0.1.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.45.0",
    "mediasoup-client": "3.23.2",
    "motion": "^13.2.0",
    "next": "16.3.5",
    "openai": "^7.15.0",
    "posthog-js": "^1.430.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.3",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1",
    "yjs": "13.6.32",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
