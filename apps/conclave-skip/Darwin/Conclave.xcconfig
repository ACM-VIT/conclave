#include "../Skip.env"

SKIP_ACTION = build

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

INFOPLIST_FILE = Info.plist
GENERATE_INFOPLIST_FILE = NO
SFU_JOIN_URL = https:/$()/conclave.acmvit.in/api/sfu/join
SFU_JOIN_URL[config=Debug][sdk=iphonesimulator*] = http:/$()/127.0.0.1:3000/api/sfu/join
CONCLAVE_AUTH_BASE_URL = https:/$()/conclave.acmvit.in
CONCLAVE_AUTH_BASE_URL[config=Debug][sdk=iphonesimulator*] = http:/$()/127.0.0.1:3000

IPHONEOS_DEPLOYMENT_TARGET = 17.0
MACOSX_DEPLOYMENT_TARGET = 14.0
SUPPORTS_MACCATALYST = NO

TARGETED_DEVICE_FAMILY = 1,2

SWIFT_EMIT_LOC_STRINGS = YES

PRODUCT_MODULE_NAME = $(PRODUCT_NAME:c99extidentifier)App

SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx

SWIFT_VERSION = 6

CODE_SIGNING_REQUIRED = NO
CODE_SIGNING_REQUIRED[sdk=iphoneos*] = YES
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = Entitlements.plist

// SYS-9 (S70 9 c): the Debug-only developer associated domain that Entitlements.plist
// reads as $(CONCLAVE_DEVELOPER_ASSOCIATED_DOMAIN). Debug adds a developer mode association,
// which a team-signed build on a device with Associated Domains Development turned on fetches
// straight from the host instead of Apple's CDN; point it at a tunnel by passing
// CONCLAVE_DEVELOPER_APPLINKS_HOST=<host> on the xcodebuild command line. Release repeats the
// production host, which the system collapses, so no developer domain ever ships.
CONCLAVE_DEVELOPER_APPLINKS_HOST = conclave.acmvit.in
CONCLAVE_DEVELOPER_ASSOCIATED_DOMAIN = applinks:conclave.acmvit.in
CONCLAVE_DEVELOPER_ASSOCIATED_DOMAIN[config=Debug] = applinks:$(CONCLAVE_DEVELOPER_APPLINKS_HOST)?mode=developer

// Debug device signing stays automatic by default. Headless builds can inject
// manual profile values on the xcodebuild command line without committing one
// developer's profile names to the project.
CONCLAVE_DEBUG_CODE_SIGN_STYLE = Automatic
CONCLAVE_DEBUG_CODE_SIGN_IDENTITY = Apple Development
CONCLAVE_DEVELOPMENT_TEAM =
CONCLAVE_APP_DEBUG_PROVISIONING_PROFILE =
CODE_SIGN_STYLE[config=Debug][sdk=iphoneos*] = $(CONCLAVE_DEBUG_CODE_SIGN_STYLE)
DEVELOPMENT_TEAM[config=Debug][sdk=iphoneos*] = $(CONCLAVE_DEVELOPMENT_TEAM)
CODE_SIGN_IDENTITY[config=Debug][sdk=iphoneos*] = $(CONCLAVE_DEBUG_CODE_SIGN_IDENTITY)
PROVISIONING_PROFILE_SPECIFIER[config=Debug][sdk=iphoneos*] = $(CONCLAVE_APP_DEBUG_PROVISIONING_PROFILE)
