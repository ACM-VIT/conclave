    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt body, shown the first time someone turns on video. One sentence in sentence case.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conclave uses your camera so people in your meeting can see you."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local network permission prompt body, shown when a call first connects its audio and video over the local network. One sentence in sentence case.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conclave uses the local network to connect your meeting’s audio and video."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Microphone permission prompt body, shown the first time someone unmutes or joins with the microphone on. One sentence in sentence case.",
