# /etc/conclave/backup.env (root-owned, mode 0600). Read by backup.sh and restore.sh.

# Checkout whose .env files hold REDIS_URL and RECORDING_STORAGE_PATH.
CONCLAVE_REPO=/home/azureuser/repos/conclave

# Host directory the SFU containers mount at /var/lib/conclave/recordings.
# Defaults to RECORDING_STORAGE_PATH from the repo .env, else this path.
#CONCLAVE_STATE_DIR=/var/lib/conclave/recordings

# age public key(s) the archive is encrypted to, one per line. The matching
# private key stays off this VM (see docs/ops/backups.md).
BACKUP_AGE_RECIPIENTS_FILE=/etc/conclave/backup-recipients.txt

# Azure Blob Storage target, written with the VM's managed identity.
AZURE_STORAGE_ACCOUNT=stconclavebackupsi
AZURE_STORAGE_CONTAINER=sfu-backups
# Only for a user-assigned identity:
#AZURE_CLIENT_ID=

# Local copies of the newest encrypted archives, for quick restores.
BACKUP_LOCAL_DIR=/var/backups/conclave
BACKUP_LOCAL_KEEP=3

# Optional dead-man's switch (for example a healthchecks.io check URL),
# pinged after each successful backup so a missed night raises an alert.
#BACKUP_HEARTBEAT_URL=

# SFU health URLs restore.sh refuses to run past (the SFUs must be stopped).
#CONCLAVE_SFU_HEALTH_URLS="http://127.0.0.1:3031/health http://127.0.0.1:3032/health"
