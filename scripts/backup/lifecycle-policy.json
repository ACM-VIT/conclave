{
  "rules": [
    {
      "enabled": true,
      "name": "conclave-daily-30-days",
      "type": "Lifecycle",
      "definition": {
        "actions": {
          "baseBlob": { "delete": { "daysAfterModificationGreaterThan": 30 } }
        },
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": ["sfu-backups/daily/"]
        }
      }
    },
    {
      "enabled": true,
      "name": "conclave-monthly-12-months",
      "type": "Lifecycle",
      "definition": {
        "actions": {
          "baseBlob": { "delete": { "daysAfterModificationGreaterThan": 365 } }
        },
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": ["sfu-backups/monthly/"]
        }
      }
    }
  ]
}
