[Unit]
Description=Conclave backup of SFU state to Azure Blob Storage
Documentation=file:///home/azureuser/repos/conclave/docs/ops/backups.md
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/home/azureuser/repos/conclave/scripts/backup/backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/backups/conclave /var/lib/conclave
